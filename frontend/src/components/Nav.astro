---
const links = [
  { href: '/', label: 'Home' },
  { href: '/analyse', label: 'Analyse' },
  { href: '/gap-map', label: 'Gap Map' },
  { href: '/known-boundary', label: 'Boundary' },
  { href: '/sessions', label: 'Sessions' },
  { href: '/settings', label: 'Settings' },
];
---
<nav class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="serif-h text-lg font-bold text-slateink">Unknown Engine</a>
    <ul class="flex gap-4">
      {links.map((l) => (
        <li>
          <a href={l.href} class="text-sm text-slateink hover:text-teal">{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>
